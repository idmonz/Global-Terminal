# Global Market Analyst Terminal optional provider setup
# Placeholder-only template. Copy to .env locally and fill only the providers you use.
# Keep this file empty of real values. Most Phase 5R candidates are free or free-tier,
# but quota, attribution and redistribution terms differ by provider.

# US macro/rates/energy/weather. Free keys are available from each official provider site.
FRED_API_KEY=
EIA_API_KEY=
BLS_API_KEY=
NASA_FIRMS_MAP_KEY=
NWS_USER_AGENT=
# Free-tier equity breadth used by the web symbol workstation when configured.
# The Phase 6F Watchlist snapshot is capped at five symbols: at most 5 Alpha
# Vantage overview calls and 10 Finnhub earnings/news calls per allowed refresh.
# Provider caches and stale last-known-good rows are read before spending calls.
# Phase 6N adds only an explicit saved-Watchlist observation action: no page-load
# polling or automatic schedule. One run is capped at 5 symbols, 16 bounded
# operations and 2 concurrent operations. Alpha Vantage documents 25 free
# requests per day, so the local quota ledger defers work before that ceiling.
# Finnhub allowance is treated conservatively and is never inferred from key
# presence. cache-only runs and every Attention review interaction use 0 calls.
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=

# Phase 6G local watchlist operations. Background refresh remains opt-in and
# uninstalled by default. The kill switches override enabled settings.
WATCHLIST_BACKGROUND_REFRESH_ENABLED=
WATCHLIST_REFRESH_KILL_SWITCH=
WATCHLIST_REFRESH_INTERVAL_SECONDS=
WATCHLIST_CHANGE_ALERT_KILL_SWITCH=

# Flights/vessels. Credentials only mean configured; the app marks them live only after a successful fetch.
AISSTREAM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Crypto and market data. CoinGecko has a free tier; Binance public endpoints are keyless for supported rows.
COINGECKO_API_KEY=
# Alias supported for compatibility; prefer ALPHAVANTAGE_API_KEY above.
ALPHA_VANTAGE_API_KEY=

# Korea free/public data keys. Add only if you have accepted the provider terms.
BOK_ECOS_API_KEY=
OPENDART_API_KEY=
KOSIS_API_KEY=
KRX_API_KEY=

# SEC requests need a descriptive User-Agent, usually "Name email@example.com".
SEC_USER_AGENT=

# Optional free-first AI. Do not enable Google Search grounding unless you explicitly want it.
GEMINI_API_KEY=
AI_PROVIDER=
AI_MODEL=
GEMINI_THINKING_LEVEL=
GEMINI_ENABLE_GOOGLE_SEARCH=

# Phase 6J optional identity/persistence. Base product remains anonymous/local.
# local-test is only for local QA and must never be used as production auth.
# Defaults when blank: provider disabled, local test identity disabled, 3600s TTL, non-secure local cookie.
GLOBAL_TERMINAL_AUTH_PROVIDER=
GLOBAL_TERMINAL_LOCAL_AUTH_ENABLED=
GLOBAL_TERMINAL_SESSION_TTL_SECONDS=
GLOBAL_TERMINAL_COOKIE_SECURE=
# Phase 6P hosted sign-in and account continuity are explicit opt-ins. Hosted
# auth uses the publishable key and a server-held opaque HttpOnly session; no
# Supabase token is written to browser storage or a NEXT_PUBLIC_* variable.
GLOBAL_TERMINAL_HOSTED_AUTH_ENABLED=false
GLOBAL_TERMINAL_HOSTED_SESSION_TTL_SECONDS=86400
GLOBAL_TERMINAL_ACCOUNT_CONTINUITY_ENABLED=false
GLOBAL_TERMINAL_SUPABASE_TIMEOUT_SECONDS=8
# Optional server-only SQLite path for account preferences. Leave blank to use the private workspace database.
GLOBAL_TERMINAL_ACCOUNT_DB_PATH=
# Optional hosted provider. Configuration alone is never shown as verified sync.
# New Supabase projects should prefer PUBLISHABLE/SECRET keys. Legacy
# ANON/SERVICE_ROLE names remain compatibility aliases through 2026.
# Keep SECRET/SERVICE_ROLE server-side only; never expose them through NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy compatibility aliases:
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional manual hosted RLS conformance only. Keep real emails and UUIDs in
# local .env; never commit them or place them in screenshots/release reports.
# PHASE6M_TEST_ACCOUNT_A_EMAIL=
# PHASE6M_TEST_ACCOUNT_B_EMAIL=
# PHASE6M_TEST_ACCOUNT_A_USER_ID=
# PHASE6M_TEST_ACCOUNT_B_USER_ID=
# PHASE6M_TEST_ACCOUNT_A_TENANT_ID=
# PHASE6M_TEST_ACCOUNT_B_TENANT_ID=
# Phase 6O local Watchlist Alert Manager worker. Page views never start it.
GLOBAL_TERMINAL_ALERT_WORKER_ENABLED=false
GLOBAL_TERMINAL_ALERT_WORKER_OBSERVE_ENABLED=false
GLOBAL_TERMINAL_ALERT_WORKER_INTERVAL_SECONDS=300

# Phase 6Q hosted recurring observation. Safe defaults keep the deployed
# runner unable to claim work until an owner has applied the migration,
# configured a private scheduler environment, and completed the hosted
# evidence handoff. SUPABASE_SECRET_KEY belongs only in the backend/worker
# secret store; never expose it through a NEXT_PUBLIC_* variable.
GLOBAL_TERMINAL_HOSTED_SCHEDULER_ENABLED=false
GLOBAL_TERMINAL_HOSTED_SCHEDULER_KILL_SWITCH=true
GLOBAL_TERMINAL_HOSTED_SCHEDULER_VERIFIED=false
GLOBAL_TERMINAL_HOSTED_SCHEDULER_EVIDENCE_PATH=
GLOBAL_TERMINAL_HOSTED_SCHEDULER_EVIDENCE_MAX_AGE_HOURS=168
GLOBAL_TERMINAL_HOSTED_SCHEDULER_LEASE_SECONDS=120
